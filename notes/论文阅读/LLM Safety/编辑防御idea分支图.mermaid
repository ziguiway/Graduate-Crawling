flowchart TB
    P["起点｜DELMAN / EVA 的核心机制<br/>key = 有害词指纹（故意造得『语境无关』）<br/>value = 统一拒绝方向<br/>KL 正则负责良性场景输出不许动"]

    P -->|"赌注①：有害 query 一定带着这些词"| A
    P -->|"赌注②：KL 兜得住一切良性场景<br/>（从未被独立测量过）"| B
    P -->|"同一套编辑骨架反方向就是攻击<br/>（你笔记 001 的 JailbreakEdit）"| C

    A["分支 A｜攻击侧：绕开词指纹"]
    B["分支 B｜用户侧：过拒绝从未被测量"]
    C["分支 C｜攻防对打：编辑 vs 编辑"]

    subgraph G4["第四章 点火：机制感知攻击"]
        expA["实验 A｜绕指纹<br/>同义词 / 谐音 / 拼音缩写 / base64 / emoji<br/>让词的表示偏出 k* 附近"]
        expC["实验 C｜编辑对冲<br/>在同一批参数位置写入竞争联想<br/>正面刚防御的拒绝记忆"]
        diag{"失效诊断：防御被绕过时<br/>key 没命中？还是 value 推不动？<br/>（两篇论文都没做过这个拆解）"}
        expA --> diag
        expC --> diag
    end

    subgraph G5["第五章 验伤：过拒绝审计"]
        expB["实验 B｜XSTest + 良性敏感 query<br/>（新闻 / 医学 / 安全研究语境）"]
        over["量出从未报告的数字：过拒绝率<br/>背景：KL 训练时良性句子只有一种句式<br/>『What is a {token}?』，部署时却面对所有句式"]
        expB --> over
    end

    A --> expA
    C --> expC
    B --> expB

    diag -->|"key 没命中<br/>→ 指纹要覆盖变体词"| imp1
    diag -->|"value 推不动<br/>→ 单句锚点太弱"| imp4
    diag -->|"value 被竞争编辑对冲<br/>→ 记忆要站得稳"| imp3
    over -->|"KL 兜不住<br/>→ 触发器必须看语境"| imp2

    subgraph G6["第六章 改设计：把 key 从语境无关改成语境感知"]
        imp1["改进 1｜双语境采样造 key<br/>有害语境 + 良性语境各采一组<br/>两组指纹可分 → 触发器看语境行事<br/>旁证：EVA 的 PCA 图显示有害 key 自聚成簇"]
        imp2["改进 2｜良性 key 刹车<br/>把良性语境指纹也写进 W_down<br/>映射到『不动作』的 value"]
        imp3["改进 3｜AlphaEdit 零空间约束<br/>安全编辑可证明不碰旧知识"]
        imp4["改进 4｜多 value 锚点<br/>单一拒绝句 → 多个拒绝方向<br/>（你笔记 002 已记的点子）"]
    end

    G6 --> val["反向验收：用第四章攻击套件<br/>+ 第五章误伤套件重测改进后模型<br/>→ 攻防闭环 = 一篇完整论文"]

    over -.->|"若过拒绝 ≈ 0：KL 确实兜得住<br/>→ 给 DELMAN 补正面证据<br/>改进只走 A / C 线"| val
    diag -.->|"若攻击全部失败：防御其实很稳<br/>→ 负结果分支：稳健性证明<br/>（价值低一档，可转短文）"| negRes["出口｜负结果"]

    cost["成本：两套代码开源 / 编辑一次 0.4h<br/>A40 即可，攻击与评测全是推理级工作"]
    risk["风险：原作者团队一年内 DELMAN→EVA<br/>持续补自己的 limitation 清单<br/>窗口期有限 → 尽早动手"]
    cost -.-> expA
    risk -.-> val

    classDef origin fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef attack fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef user fill:#fef9c3,stroke:#ca8a04,color:#713f12
    classDef diag fill:#f3e8ff,stroke:#9333ea,color:#581c87
    classDef fix fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef result fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
    classDef note fill:#ffffff,stroke:#94a3b8,color:#475569

    class P origin
    class A,expA,C,expC attack
    class B,expB,over user
    class diag diag
    class imp1,imp2,imp3,imp4 fix
    class val result
    class negRes,cost,risk note
